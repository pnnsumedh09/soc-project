# Grader builds use repository defaults. Explicit -D values still take priority.
set(_soc_board_default OFF)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _soc_processor)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _soc_processor MATCHES "^(aarch64|arm64)$")
    set(_soc_board_default ON)
endif()
option(GGML_SOC_GEMV "Build the SoC Q8_0 GEMV integration" ${_soc_board_default})
option(GGML_SOC_GEMV_FPGA "Build the Linux FPGA backend" ${_soc_board_default})
option(GGML_SOC_GEMV_XRT "Use the existing PYNQ XRT/ZOCL DMA allocator" ${_soc_board_default})
if(_soc_board_default)
    option(GGML_NATIVE "Compile for native host features" OFF)
    option(GGML_LLAMAFILE "Enable llamafile matrix kernels" OFF)
    option(GGML_CPU_REPACK "Enable upstream CPU weight conversion" OFF)
    option(LLAMA_BUILD_UI "Build the embedded Web UI" OFF)
    option(LLAMA_USE_PREBUILT_UI "Download prebuilt Web UI assets" OFF)
    option(LLAMA_OPENSSL "Enable HTTPS support" OFF)
    option(BUILD_SHARED_LIBS "Build shared libraries" OFF)
endif()
unset(_soc_processor)
unset(_soc_board_default)

# Production checkout omits upstream test directories.
option(LLAMA_BUILD_TESTS "Build llama.cpp tests" OFF)
option(GGML_BUILD_TESTS "Build ggml tests" OFF)
